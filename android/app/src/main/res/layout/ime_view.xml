<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F2F3F5"
    android:padding="6dp">

    <!-- 已输入前缀 -->
    <TextView
        android:id="@+id/draft_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:maxLines="3"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:gravity="center_vertical"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#17181B"
        android:text="∅" />

    <!-- 候选大按钮区（2 列） -->
    <GridLayout
        android:id="@+id/candidates_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="false" />

    <!-- 状态/错误提示 -->
    <TextView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:textSize="12sp"
        android:textColor="#B45309"
        android:visibility="gone" />

    <!-- 情绪/立场调制行：把语气选择权直接交给用户 -->
    <LinearLayout
        android:id="@+id/tone_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_tone_neg"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="#FFFFFF"
            android:textSize="15sp"
            android:text="😔 更消极" />

        <Button
            android:id="@+id/btn_tone_pos"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="#FFFFFF"
            android:textSize="15sp"
            android:text="😊 更积极" />
    </LinearLayout>

    <!-- 操作行 -->
    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_undo"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="#FFFFFF"
            android:textSize="15sp"
            android:text="撤销" />

        <Button
            android:id="@+id/btn_clip"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="#FFFFFF"
            android:textSize="15sp"
            android:text="📋 对方" />

        <Button
            android:id="@+id/btn_more"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="#FFFFFF"
            android:textSize="15sp"
            android:text="换一批" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.15"
            android:layout_margin="3dp"
            android:background="#07C160"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="发送" />
    </LinearLayout>

    <!-- 键盘回退模式：输入框 + 并入/返回 -->
    <LinearLayout
        android:id="@+id/kb_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/kb_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_margin="3dp"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:textSize="16sp"
            android:hint="这里直接打字，并入后继续智能候选…"
            android:inputType="text"
            android:maxLength="200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_kb_back"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="#FFFFFF"
                android:textSize="15sp"
                android:text="返回" />

            <Button
                android:id="@+id/btn_kb_commit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="#07C160"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="并入" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
